# --- Server -----------------------------------------------------------
PORT=4000
CORS_ORIGIN=http://localhost:5173          # exact frontend origin (credentials are enabled — never use *)
LOG_LEVEL=info

# --- Postgres ---------------------------------------------------------
DATABASE_URL=postgres://taskboard:taskboard@localhost:5432/taskboard
DB_POOL_MAX=10

# --- Redis (pub/sub, presence, cache) ---------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------
JWT_SECRET=change-me                       # >= 32 random bytes in real use
ACCESS_TOKEN_TTL_SECONDS=900               # ~15 minutes
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false                        # true behind HTTPS
BCRYPT_COST=12

# --- Limits -----------------------------------------------------------
JSON_BODY_LIMIT=16kb
RATE_LIMIT_AUTH_PER_MIN=10
